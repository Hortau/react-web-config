{
  "name": "@hortau/react-web-config",
  "version": "2.0.0",
  "description": "react-native-config for web",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./lib/ReactWebConfig": "./lib/ReactWebConfig.js",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "bun test",
    "build": "bun build src/index.js src/ReactWebConfig.js --outdir lib --target node --format cjs --external webpack --external dotenv",
    "prepublishOnly": "bun run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hortau/react-web-config.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "keywords": [
    "react",
    "native",
    "config",
    "react-native-config",
    "react-native-web",
    "web",
    "env",
    "dot-env"
  ],
  "author": "Tan Li Hau <lhtan93@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/hortau/react-web-config/issues"
  },
  "homepage": "https://github.com/hortau/react-web-config#readme",
  "dependencies": {
    "dotenv": ">=8.0.0 <18.0.0"
  },
  "peerDependencies": {
    "webpack": "^5.0.0"
  }
}
